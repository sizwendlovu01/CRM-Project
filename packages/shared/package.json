{
  "name": "@crm/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared domain enums, validation schemas, permissions and plan definitions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
