# ---------------------------------------------------------------------------
# Docker Compose (docker compose up --build) - copy to .env and fill in secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=crm
SESSION_SECRET=change-me-to-at-least-32-random-characters
APP_URL=http://localhost:3000
# Set to true when serving over HTTPS (required in production).
COOKIE_SECURE=false
SWAGGER_ENABLED=true
LOG_LEVEL=info
# Optional: password for the demo seed accounts (docker compose --profile seed run --rm seed).
# Leave empty to generate a random one that is printed once.
SEED_PASSWORD=
# Required only for the monitoring profile.
GRAFANA_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Running without Docker (pnpm dev): put these in apps/api/.env
# ---------------------------------------------------------------------------
# NODE_ENV=development
# PORT=4000
# DATABASE_URL=postgresql://crm:<password>@localhost:5432/crm_app?schema=public
# TEST_DATABASE_URL=postgresql://crm:<password>@localhost:5432/crm_test?schema=public
# REDIS_URL=redis://localhost:6379          # optional: omit to use in-process jobs and memory rate limits
# APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
# SESSION_SECRET=<32+ random characters>
# SMTP_HOST=localhost
# SMTP_PORT=1025                              # Mailpit
# MAIL_FROM="Enterprise CRM <no-reply@crm.local>"
# RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE=10
# SEED_PASSWORD=<choose one>
#
# apps/web/.env.local (optional): API_INTERNAL_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Vercel (set in each project's Environment Variables, see docs/deployment.md)
# ---------------------------------------------------------------------------
# API project: DATABASE_URL (+ DATABASE_URL_UNPOOLED from Neon), SESSION_SECRET, APP_URL, CORS_ORIGINS,
#              COOKIE_SECURE=true, TRUST_PROXY=true, PROXY_SECRET, CRON_SECRET, MAIL_TRANSPORT=none or SMTP_*
# Web project: API_INTERNAL_URL=https://<api-project>.vercel.app, PROXY_SECRET (same value as the API)
