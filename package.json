{
  "name": "enterprise-saas-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant enterprise CRM platform built with Next.js, NestJS, PostgreSQL and Redis.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @crm/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @crm/api --filter @crm/web dev",
    "start": "pnpm --parallel --filter @crm/api --filter @crm/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @crm/api test:integration",
    "test:e2e": "pnpm --filter @crm/web test:e2e",
    "db:migrate": "pnpm --filter @crm/api db:migrate",
    "db:deploy": "pnpm --filter @crm/api db:deploy",
    "db:seed": "pnpm --filter @crm/api db:seed",
    "db:studio": "pnpm --filter @crm/api exec prisma studio"
  }
}
